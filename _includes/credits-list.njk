                <div class="credits">
                    <p>{{ ts.credits.intro }} <a href="{{ photos.licence.url }}">{{ photos.licence.name }}</a>.</p>
                    <ul class="credits-list">
                        {%- for src in photos.sources %}
                        {%- set used = src.crops[siteKey] %}
                        {%- if used and used.length %}
                        <li>
                            <a href="{{ src.url }}">&ldquo;{{ src.title }}&rdquo;</a> {{ ts.credits.by }} {{ src.author }}, <a href="{{ photos.licence.url }}">{{ photos.licence.name }}</a>
                            <span>{{ ts.credits.usedFor }} {{ used | join(", ") }}</span>
                        </li>
                        {%- endif %}
                        {%- endfor %}
                    </ul>
                    {%- if siteKey == "kumaon" %}
                    <p>{{ ts.credits.aiCoaster }}</p>
                    {%- endif %}
                    <p>{{ ts.credits.icons }} <a href="https://lucide.dev">Lucide</a> {{ ts.credits.iconsLicence }}</p>
                </div>

<div class="product-card" data-category="{{ p.filter }}">
    <div class="product-badge">{{ p.tag }}</div>
    <div class="product-image">
        <img src="{{ base }}{{ p.img }}-800.webp" srcset="{{ base }}{{ p.img }}-480.webp 480w, {{ base }}{{ p.img }}-800.webp 800w" sizes="(max-width: 768px) 100vw, 380px" alt="{{ p.title }}" width="800" height="600" loading="lazy" decoding="async">
    </div>
    <div class="product-info">
        <span class="product-category">{{ p.label }}</span>
        <h3>{{ p.title }}</h3>
        <div class="product-price">{{ p.price }}</div>
        <div class="product-actions">
            <button type="button" class="view-details" data-id="{{ p.id }}">{{ t.viewDetails }}</button>
        </div>
    </div>
</div>

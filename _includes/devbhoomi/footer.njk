    <!-- Footer -->
    <footer>
        <div class="footer-top">
            <div class="footer-col footer-logo">
                <h2>{{ t.name }}</h2>
                <p>{{ t.footerText }}</p>
                {%- set social = devbhoomi.contact.social %}
                {%- if social.facebook or social.instagram or social.youtube %}
                <div class="footer-socials">
                    {%- set socialClass = "" %}
                    {%- include "social-links.njk" %}
                </div>
                {%- endif %}
            </div>
            <div class="footer-col">
                <h3>{{ t.quickLinks }}</h3>
                <ul class="footer-links">
                    <li><a href="index.html">{{ ts.nav.index }}</a></li>
                    <li><a href="about.html">{{ ts.nav.about }}</a></li>
                    <li><a href="products.html">{{ t.linkCatalogue }}</a></li>
                    <li><a href="gallery.html">{{ ts.nav.gallery }}</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>{{ t.categoriesTitle }}</h3>
                <ul class="footer-links">
                    <li><a href="products.html">{{ t.categories[0] }}</a></li>
                    <li><a href="products.html">{{ t.categories[1] }}</a></li>
                    <li><a href="products.html">{{ t.categories[2] }}</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>{{ t.newsletterTitle }}</h3>
                <p>{{ t.newsletterText }}</p>
                {%- if devbhoomi.contact.newsletterEndpoint %}
                <form class="newsletter-form" id="newsletter-form" novalidate data-endpoint="{{ devbhoomi.contact.newsletterEndpoint }}">
                    <label for="newsletter-email" class="visually-hidden">{{ ts.newsletterEmailLabel }}</label>
                    <input type="email" id="newsletter-email" name="email" autocomplete="email" class="newsletter-input" placeholder="{{ ts.emailPlaceholder }}" required>
                    <button type="submit" class="newsletter-btn">{{ t.subscribe }}</button>
                </form>
                {%- else %}
                <p class="newsletter-soon">{{ ts.newsletterSoon }}</p>
                {%- endif %}
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; {{ t.copyright }} &middot; <a href="credits.html">{{ ts.photoCredits }}</a> &middot; <a href="{{ base }}../index.html">{{ ts.allSites }}</a></p>
            <p>{{ t.tagline }}</p>
        </div>
    </footer>
